---
import { ClientRouter } from "astro:transitions";
import { reportMeta, groupOrder, reportMetaEn, groupOrderEn } from "../lib/reportMeta";

interface Props {
  title: string;
  description?: string;
  activeSlug?: string;
  lang?: "ko" | "en";
}
const {
  title,
  description,
  activeSlug,
  lang = "ko",
} = Astro.props;

const isEn = lang === "en";
const defaultDescription = isEn
  ? "A data analysis project for YC batch selection."
  : "YC 배치 선정을 위한 데이터 분석 프로젝트.";
const finalDescription = description ?? defaultDescription;

const pageTitle = `${title} · YC Research`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

const meta = isEn ? reportMetaEn : reportMeta;
const groups = (isEn ? groupOrderEn : groupOrder).map((group) => ({
  group,
  items: Object.entries(meta)
    .filter(([, m]) => m.group === group)
    .map(([slug, m]) => ({ slug, title: m.title })),
}));

const homeHref = isEn ? "/en/" : "/";
const reportsBase = isEn ? "/en/reports" : "/reports";
const otherLangHref = isEn ? Astro.url.pathname.replace(/^\/en/, "") || "/" : `/en${Astro.url.pathname}`;

const t = isEn
  ? {
      themeLabel: "Theme selection",
      light: "Light",
      dark: "Dark",
      system: "System",
      langLabel: "Language selection",
      githubLabel: "GitHub repository",
    }
  : {
      themeLabel: "테마 선택",
      light: "라이트",
      dark: "다크",
      system: "시스템",
      langLabel: "언어 선택",
      githubLabel: "GitHub 저장소",
    };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={finalDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="YC Research" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site ?? Astro.url.origin)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site ?? Astro.url.origin)} />

    <ClientRouter />
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.setAttribute("data-theme", saved);
        }
      })();
    </script>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar" transition:persist={`sidebar-${lang}`}>
        <div class="brand-row">
          <a class="brand" href={homeHref}>YC Research</a>
          <a
            class="github-link"
            href="https://github.com/Jaeooo/yc-research"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.githubLabel}
          >
            <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
          </a>
        </div>
        <div class="theme-toggle" role="radiogroup" aria-label={t.themeLabel}>
          <button type="button" data-theme-choice="light" aria-pressed="false">{t.light}</button>
          <button type="button" data-theme-choice="dark" aria-pressed="false">{t.dark}</button>
          <button type="button" data-theme-choice="system" aria-pressed="false">{t.system}</button>
        </div>
        <div class="lang-toggle" role="radiogroup" aria-label={t.langLabel}>
          <a href={isEn ? otherLangHref : Astro.url.pathname} aria-pressed={!isEn}>한국어</a>
          <a href={isEn ? Astro.url.pathname : otherLangHref} aria-pressed={isEn}>English</a>
        </div>
        <nav>
          {groups.map(({ group, items }) => (
            <div class="nav-group">
              <p class="nav-group-title">{group}</p>
              <ul>
                {items.map((item) => (
                  <li>
                    <a
                      href={`${reportsBase}/${item.slug}/`}
                      aria-current={activeSlug === item.slug ? "page" : undefined}
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>
      <main transition:animate="slide">
        <slot />
      </main>
    </div>
    <script>
      function syncActiveLink() {
        const links = document.querySelectorAll<HTMLAnchorElement>(".nav-group a");
        links.forEach((link) => {
          const isActive = link.pathname === window.location.pathname;
          if (isActive) {
            link.setAttribute("aria-current", "page");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      }

      function applyTheme(choice: string) {
        if (choice === "light" || choice === "dark") {
          document.documentElement.setAttribute("data-theme", choice);
          localStorage.setItem("theme", choice);
        } else {
          document.documentElement.removeAttribute("data-theme");
          localStorage.removeItem("theme");
        }
        syncThemeButtons();
      }

      function syncThemeButtons() {
        const current = localStorage.getItem("theme") ?? "system";
        document.querySelectorAll<HTMLButtonElement>("[data-theme-choice]").forEach((btn) => {
          btn.setAttribute("aria-pressed", String(btn.dataset.themeChoice === current));
        });
      }

      function initThemeToggle() {
        document.querySelectorAll<HTMLButtonElement>("[data-theme-choice]").forEach((btn) => {
          if (btn.dataset.bound) return;
          btn.dataset.bound = "true";
          btn.addEventListener("click", () => applyTheme(btn.dataset.themeChoice!));
        });
        syncThemeButtons();
      }

      document.addEventListener("astro:page-load", syncActiveLink);
      document.addEventListener("astro:page-load", initThemeToggle);
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --fg: #1a1a1a;
    --muted: #6b6b6b;
    --border: #e5e5e5;
    --accent: #2563eb;
    --card-bg: #f7f7f8;
    --sidebar-bg: #fafafa;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1115;
      --fg: #e8e8e8;
      --muted: #9a9a9a;
      --border: #262a33;
      --accent: #5b8def;
      --card-bg: #171a21;
      --sidebar-bg: #14161b;
    }
  }
  :root[data-theme="light"] {
    --bg: #ffffff;
    --fg: #1a1a1a;
    --muted: #6b6b6b;
    --border: #e5e5e5;
    --accent: #2563eb;
    --card-bg: #f7f7f8;
    --sidebar-bg: #fafafa;
  }
  :root[data-theme="dark"] {
    --bg: #0f1115;
    --fg: #e8e8e8;
    --muted: #9a9a9a;
    --border: #262a33;
    --accent: #5b8def;
    --card-bg: #171a21;
    --sidebar-bg: #14161b;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Pretendard, sans-serif;
    line-height: 1.6;
  }
  table {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    width: 100%;
  }
  th, td {
    border: 1px solid var(--border);
    padding: 0.4rem 0.7rem;
    text-align: left;
    white-space: nowrap;
  }
  code {
    background: var(--card-bg);
    color: var(--fg);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-size: 0.9em;
  }
  pre {
    background: var(--card-bg);
    color: var(--fg);
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    border: 1px solid var(--border);
  }
  pre code {
    background: none;
    padding: 0;
    color: inherit;
  }
  a { color: var(--accent); }
  blockquote {
    margin: 0;
    padding: 0.25rem 1rem;
    border-left: 3px solid var(--border);
    color: var(--muted);
  }
</style>

<style>
  .shell {
    display: grid;
    grid-template-columns: 280px 1fr;
    min-height: 100vh;
  }
  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    border-right: 1px solid var(--border);
    background: var(--sidebar-bg);
    padding: 1.25rem 1rem;
  }
  .brand-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .brand {
    display: block;
    color: var(--fg);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.05rem;
  }
  .github-link {
    display: flex;
    color: var(--muted);
  }
  .github-link:hover {
    color: var(--fg);
  }
  .theme-toggle {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 0.75rem;
    background: var(--card-bg);
    border-radius: 8px;
    padding: 0.2rem;
  }
  .theme-toggle button {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 0.75rem;
    padding: 0.35rem 0.4rem;
    border-radius: 6px;
    cursor: pointer;
  }
  .theme-toggle button[aria-pressed="true"] {
    background: var(--accent);
    color: #fff;
  }
  .lang-toggle {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1.5rem;
    background: var(--card-bg);
    border-radius: 8px;
    padding: 0.2rem;
  }
  .lang-toggle a {
    flex: 1;
    text-align: center;
    text-decoration: none;
    color: var(--muted);
    font-size: 0.75rem;
    padding: 0.35rem 0.4rem;
    border-radius: 6px;
  }
  .lang-toggle a[aria-pressed="true"] {
    background: var(--accent);
    color: #fff;
  }
  .nav-group {
    margin-bottom: 1.25rem;
  }
  .nav-group-title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }
  .nav-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.15rem;
  }
  .nav-group a {
    display: block;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    color: var(--fg);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .nav-group a:hover {
    background: var(--card-bg);
  }
  .nav-group a[aria-current="page"] {
    background: var(--accent);
    color: #fff;
  }
  main {
    padding: 2.5rem 3rem 5rem;
    max-width: 1100px;
    width: 100%;
  }
  @media (max-width: 860px) {
    .shell {
      grid-template-columns: 1fr;
    }
    .sidebar {
      position: static;
      height: auto;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }
    main {
      padding: 1.5rem 1.25rem 3rem;
    }
  }
</style>

---
import Base from "../../../layouts/Base.astro";
import LineChart from "../../../components/LineChart.astro";
import BarChart from "../../../components/BarChart.astro";
import { getCollection, render } from "astro:content";
import { reportMetaEn } from "../../../lib/reportMeta";
import {
  companiesByYear,
  aiShareByYear,
  industryDistribution,
  statusDistribution,
  recentBatches,
  teamSizeDistribution,
} from "../../../lib/companiesData";

export async function getStaticPaths() {
  const entries = await getCollection("reportsEn");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const meta = reportMetaEn[entry.id];
const showCompaniesCharts = entry.id === "yc_companies_report";
---
<Base
  title={meta?.title ?? entry.id}
  description={meta?.description}
  activeSlug={entry.id}
  lang="en"
>
  <article class:list={["markdown", { "hide-tables": showCompaniesCharts }]} id="report-body">
    <Content />
  </article>
  {showCompaniesCharts && (
    <div id="chart-pool" hidden>
      <div data-after-table="1"><LineChart id="companies-by-year" title="Companies by Year" points={[...companiesByYear].reverse()} /></div>
      <div data-after-table="2"><BarChart id="industry-distribution" title="Distribution by Industry" points={industryDistribution} /></div>
      <div data-after-table="3"><BarChart id="status-distribution" title="Company Status" points={statusDistribution} /></div>
      <div data-after-table="4">
        <LineChart
          id="ai-share-by-year"
          title="AI Company Share Over Time"
          points={[...aiShareByYear].reverse()}
          valueFormat={(v) => `${v}%`}
        />
      </div>
      <div data-after-table="5"><BarChart id="recent-batches" title="Companies by Recent Batch (last 12)" points={recentBatches} /></div>
      <div data-after-table="6"><BarChart id="team-size" title="Team Size Distribution" points={teamSizeDistribution} /></div>
    </div>
  )}
</Base>

<style>
  .markdown.hide-tables :global(table) {
    display: none;
  }
</style>

{showCompaniesCharts && (
  <script>
    function placeCharts() {
      const pool = document.getElementById("chart-pool");
      const article = document.getElementById("report-body");
      if (!pool || !article) return;

      const tables = article.querySelectorAll("table");
      pool.querySelectorAll<HTMLElement>("[data-after-table]").forEach((wrapper) => {
        const index = Number(wrapper.dataset.afterTable) - 1;
        const table = tables[index];
        if (!table) return;
        table.after(wrapper);
        wrapper.hidden = false;
      });
      pool.remove();
    }
    document.addEventListener("astro:page-load", placeCharts);
  </script>
)}
